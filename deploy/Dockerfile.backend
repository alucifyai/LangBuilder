FROM langflowai/langflow-backend:latest

# Install system dependencies for RBAC
RUN apt-get update && apt-get install -y \
    curl \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Copy RBAC implementation
COPY src/backend/base/langflow/ /app/langflow/

# Install additional Python dependencies for RBAC
COPY deploy/requirements-rbac.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-rbac.txt

# Set environment variables
ENV RBAC_ENABLED=true
ENV PYTHONPATH=/app:$PYTHONPATH
ENV LANGFLOW_AUTO_MIGRATE=true

# Create RBAC data directory
RUN mkdir -p /app/data/rbac

# Health check including RBAC endpoints
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:7860/health && \
        curl -f http://localhost:7860/api/v1/rbac/permissions/resource-types || exit 1

EXPOSE 7860

# Run with RBAC initialization
CMD ["python", "-m", "langflow", "run", "--host", "0.0.0.0", "--port", "7860"]