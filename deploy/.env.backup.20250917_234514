# ===============================
# LANGBUILDER WITH RBAC - ENVIRONMENT CONFIGURATION
# ===============================

# ===============================
# DOMAIN & INFRASTRUCTURE
# ===============================

# Your domain name (replace with your actual domain for production)
DOMAIN=langbuilder.example.com
STACK_NAME=langbuilder-rbac
TRAEFIK_TAG=langbuilder-rbac
TRAEFIK_PUBLIC_TAG=traefik-public
TRAEFIK_PUBLIC_NETWORK=traefik-public
TRAEFIK_PUBLIC_NETWORK_IS_EXTERNAL=false

# ===============================
# RBAC CONFIGURATION
# ===============================

# Enable RBAC features
RBAC_ENABLED=true

# Initial superuser (created on first startup)
RBAC_SUPER_USER_EMAIL=admin@example.com
RBAC_SUPER_USER_PASSWORD=dongming

# Permission Engine Settings
RBAC_CACHE_TTL=300
RBAC_CACHE_DENY_TTL=60
RBAC_AUDIT_ENABLED=true

# ===============================
# LANGBUILDER CONFIGURATION
# ===============================

# Backend configuration
LANGFLOW_LOG_LEVEL=info
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=REPLACE_WITH_SECURE_SUPERUSER_PASSWORD
LANGFLOW_NEW_USER_IS_ACTIVE=false

# JWT Secret Key (generate with: openssl rand -hex 32)
LANGFLOW_SECRET_KEY=jhVoP7xUBpUlhEoQdQZpXPAezzDUjE28BIXHKzXysOM=

# Frontend configuration
BACKEND_URL=http://backend:7860

# ===============================
# DATABASE CONFIGURATION
# ===============================

# PostgreSQL Database
POSTGRES_USER=langflow
POSTGRES_PASSWORD=dongming
POSTGRES_DB=langflow
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database URL for LangBuilder
LANGFLOW_DATABASE_URL=postgresql://langflow:REPLACE_WITH_SECURE_DB_PASSWORD@db:5432/langflow

# Legacy DB configuration (for compatibility)
DB_USER=langflow
DB_PASSWORD=REPLACE_WITH_SECURE_DB_PASSWORD
DB_HOST=db
DB_PORT=5432
DB_NAME=langflow

# ===============================
# REDIS CONFIGURATION
# ===============================

LANGFLOW_REDIS_HOST=result_backend
LANGFLOW_REDIS_PORT=6379
LANGFLOW_REDIS_DB=0
LANGFLOW_REDIS_EXPIRE=3600
LANGFLOW_REDIS_PASSWORD=
REDIS_URL=redis://result_backend:6379/0

# ===============================
# MESSAGE BROKER (RabbitMQ)
# ===============================

RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=dongming
BROKER_URL=amqp://admin:REPLACE_WITH_SECURE_RABBITMQ_PASSWORD@broker:5672//
RESULT_BACKEND=redis://result_backend:6379/0

# ===============================
# CELERY CONFIGURATION
# ===============================

C_FORCE_ROOT="true"
FLOWER_UNAUTHENTICATED_API=True

# ===============================
# PGADMIN CONFIGURATION
# ===============================

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_SECURE_PGADMIN_PASSWORD

# ===============================
# MONITORING CONFIGURATION
# ===============================

# Grafana Dashboard
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_SECURE_GRAFANA_PASSWORD

# ===============================
# SECURITY REMINDER
# ===============================
# 
# IMPORTANT: Replace all REPLACE_WITH_* values with secure, randomly generated passwords
# Generate secure passwords with: openssl rand -base64 32
# Generate JWT secret with: openssl rand -hex 32
