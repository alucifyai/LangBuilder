{
  "metadata": {
    "name": "LangBuilder Application Graph (Actual Implementation)",
    "version": "2.0.0",
    "description": "Corrected application graph reflecting the actual simple authentication implementation found in the codebase",
    "analysis_date": "2025-09-09",
    "code_analysis_performed": true,
    "major_corrections": [
      "Replaced comprehensive RBAC system with actual simple authentication",
      "Removed non-existent role/permission entities",
      "Updated logic nodes to reflect actual code functions",
      "Simplified authorization to superuser checks and resource ownership"
    ]
  },
  "authentication_security_subsystem": {
    "id": "authentication_security_actual",
    "name": "Authentication & Security (Actual Implementation)",
    "description": "Simple authentication system with user management, API keys, and basic authorization",
    "nodes": {
      "schema_nodes": [
        {
          "id": "user_entity",
          "type": "schema",
          "name": "User",
          "description": "User account with basic authentication and superuser capabilities",
          "path": "src/backend/base/langflow/services/database/models/user/model.py",
          "actual_fields": [
            "id: UUIDstr",
            "username: str",
            "password: str",
            "is_active: bool",
            "is_superuser: bool",
            "create_at: datetime",
            "updated_at: datetime",
            "last_login_at: datetime | None",
            "api_keys: list[ApiKey]",
            "flows: list[Flow]",
            "variables: list[Variable]",
            "folders: list[Folder]"
          ]
        },
        {
          "id": "api_key_entity", 
          "type": "schema",
          "name": "ApiKey",
          "description": "API key authentication with usage tracking",
          "path": "src/backend/base/langflow/services/database/models/api_key/model.py",
          "actual_fields": [
            "id: UUIDstr",
            "api_key: str",
            "name: str | None",
            "user_id: UUIDstr",
            "is_active: bool",
            "total_uses: int",
            "last_used_at: datetime | None",
            "created_at: datetime",
            "user: User"
          ]
        }
      ],
      "logic_nodes": [
        {
          "id": "authentication_system",
          "type": "logic", 
          "name": "Authentication System",
          "description": "JWT and API key authentication with user validation - actual implementation",
          "path": "src/backend/base/langflow/services/auth/utils.py",
          "actual_functions": [
            "get_current_user(token: Annotated[str, Depends(api_key_security)])",
            "api_key_security(authorization_header: str | None = Header(None, alias='Authorization'))",
            "get_current_user_by_jwt(token: Annotated[str, Depends(oauth2_scheme)])",
            "verify_password(plain_password: str, hashed_password: str)",
            "create_access_token(data: dict[str, Any], expires_delta: timedelta | None = None)",
            "validate_api_key(api_key_value: str, db: Session)"
          ],
          "statechart": {
            "id": "authenticationStatechart",
            "initial": "idle",
            "context": {
              "current_user": null,
              "auth_method": null,
              "token": null
            },
            "states": {
              "idle": {
                "on": {
                  "AUTH_REQUEST": "determining_method"
                }
              },
              "determining_method": {
                "entry": ["check_authorization_header"],
                "always": [
                  {
                    "target": "validating_api_key",
                    "cond": "has_api_key"
                  },
                  {
                    "target": "validating_jwt",
                    "cond": "has_jwt_token"
                  },
                  {
                    "target": "unauthenticated"
                  }
                ]
              },
              "validating_api_key": {
                "invoke": {
                  "id": "validateApiKey",
                  "src": "validate_api_key",
                  "onDone": {
                    "target": "authenticated",
                    "actions": ["set_current_user"]
                  },
                  "onError": "authentication_failed"
                }
              },
              "validating_jwt": {
                "invoke": {
                  "id": "validateJWT", 
                  "src": "get_current_user_by_jwt",
                  "onDone": {
                    "target": "authenticated",
                    "actions": ["set_current_user"]
                  },
                  "onError": "authentication_failed"
                }
              },
              "authenticated": {
                "on": {
                  "CHECK_SUPERUSER": "checking_superuser",
                  "LOGOUT": "logging_out"
                }
              },
              "checking_superuser": {
                "invoke": {
                  "id": "checkSuperuser",
                  "src": "get_current_active_superuser",
                  "onDone": "superuser_confirmed",
                  "onError": "superuser_denied"
                }
              },
              "superuser_confirmed": {
                "type": "final"
              },
              "superuser_denied": {
                "type": "final"
              },
              "authentication_failed": {
                "type": "final"
              },
              "logging_out": {
                "entry": ["clear_user_session"],
                "always": "unauthenticated"
              },
              "unauthenticated": {
                "entry": ["clear_auth_context"],
                "on": {
                  "AUTH_REQUEST": "determining_method"
                }
              }
            }
          }
        },
        {
          "id": "simple_authorization_system",
          "type": "logic",
          "name": "Simple Authorization System", 
          "description": "Basic authorization with superuser checks and resource ownership validation - actual implementation",
          "path": "src/backend/base/langflow/services/auth/utils.py",
          "actual_functions": [
            "get_current_active_user(user: Annotated[User, Depends(get_current_user)])",
            "get_current_active_superuser(current_user: Annotated[User, Depends(get_current_active_user)])"
          ],
          "authorization_pattern": [
            "check_user_authenticated",
            "check_user_active", 
            "check_resource_ownership_or_superuser",
            "grant_or_deny_access"
          ],
          "statechart": {
            "id": "simpleAuthorizationStatechart",
            "initial": "checking_authentication",
            "context": {
              "user": null,
              "resource": null,
              "is_superuser": false,
              "is_owner": false
            },
            "states": {
              "checking_authentication": {
                "invoke": {
                  "id": "checkAuth",
                  "src": "get_current_active_user", 
                  "onDone": {
                    "target": "checking_access",
                    "actions": ["store_user"]
                  },
                  "onError": "access_denied"
                }
              },
              "checking_access": {
                "entry": ["determine_access_requirements"],
                "always": [
                  {
                    "target": "access_granted", 
                    "cond": "is_superuser"
                  },
                  {
                    "target": "checking_ownership",
                    "cond": "requires_ownership_check"
                  },
                  {
                    "target": "access_granted"
                  }
                ]
              },
              "checking_ownership": {
                "entry": ["validate_resource_ownership"],
                "always": [
                  {
                    "target": "access_granted",
                    "cond": "is_resource_owner"
                  },
                  {
                    "target": "access_denied"
                  }
                ]
              },
              "access_granted": {
                "entry": ["log_access_granted"],
                "type": "final"
              },
              "access_denied": {
                "entry": ["log_access_denied"],
                "type": "final"
              }
            }
          }
        },
        {
          "id": "user_management_system",
          "type": "logic",
          "name": "User Management System",
          "description": "User CRUD operations with password hashing and basic validation",
          "path": "src/backend/base/langflow/api/v1/users.py",
          "actual_functions": [
            "add_user(user: UserCreate, session: DbSession)",
            "read_current_user(current_user: CurrentActiveUser)",
            "read_users(skip: int = 0, limit: int = 100, session: DbSession)",
            "read_user_by_id(user_id: UUID, session: DbSession)",
            "patch_user(user_id: UUID, user: UserUpdate, session: DbSession)",
            "delete_user(user_id: UUID, session: DbSession)"
          ],
          "statechart": {
            "id": "userManagementStatechart",
            "initial": "idle",
            "states": {
              "idle": {
                "on": {
                  "CREATE_USER": "creating_user",
                  "READ_USER": "reading_user", 
                  "UPDATE_USER": "updating_user",
                  "DELETE_USER": "deleting_user"
                }
              },
              "creating_user": {
                "entry": ["validate_user_data", "hash_password"],
                "invoke": {
                  "id": "createUser",
                  "src": "add_user",
                  "onDone": {
                    "target": "user_created",
                    "actions": ["create_default_folder"]
                  },
                  "onError": "creation_failed"
                }
              },
              "reading_user": {
                "invoke": {
                  "id": "readUser",
                  "src": "read_user_by_id",
                  "onDone": "user_read",
                  "onError": "read_failed"
                }
              },
              "updating_user": {
                "entry": ["validate_update_data"],
                "invoke": {
                  "id": "updateUser", 
                  "src": "patch_user",
                  "onDone": "user_updated",
                  "onError": "update_failed"
                }
              },
              "deleting_user": {
                "invoke": {
                  "id": "deleteUser",
                  "src": "delete_user", 
                  "onDone": "user_deleted",
                  "onError": "deletion_failed"
                }
              },
              "user_created": {
                "type": "final"
              },
              "user_read": {
                "type": "final"
              },
              "user_updated": {
                "type": "final"
              },
              "user_deleted": {
                "type": "final"
              },
              "creation_failed": {
                "type": "final"
              },
              "read_failed": {
                "type": "final"
              },
              "update_failed": {
                "type": "final"
              },
              "deletion_failed": {
                "type": "final"
              }
            }
          }
        }
      ]
    },
    "edges": [
      {
        "id": "edge_auth_1",
        "source": "authentication_system",
        "target": "user_entity", 
        "type": "data_operation",
        "description": "Authentication system reads user data for validation"
      },
      {
        "id": "edge_auth_2",
        "source": "authentication_system",
        "target": "api_key_entity",
        "type": "data_operation", 
        "description": "Authentication system validates API keys"
      },
      {
        "id": "edge_auth_3",
        "source": "simple_authorization_system",
        "target": "authentication_system",
        "type": "logic_dependency",
        "description": "Authorization depends on authentication"
      },
      {
        "id": "edge_auth_4",
        "source": "user_management_system",
        "target": "user_entity",
        "type": "data_operation",
        "description": "User management performs CRUD operations on users"
      }
    ]
  }
}